PORT=3001
HOST=0.0.0.0
NODE_ENV=development
DATABASE_PATH=./data/zaka.sqlite
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Set true only for the local demo; never use demo passwords on a public server.
SEED_DEMO_ACCOUNTS=false
# Optional first owner. Created only if the phone is not already registered.
OWNER_NAME=Zaka Owner
OWNER_PHONE=
OWNER_PASSWORD=
# Comma-separated OAuth client IDs accepted as Google token audiences.
GOOGLE_CLIENT_IDS=
# Use the exact base URL displayed in your Veriff integration dashboard.
VERIFF_BASE_URL=https://stationapi.veriff.com
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_ENVIRONMENT=test
# Customer browser return URL, NOT the decision webhook URL.
VERIFF_CALLBACK_URL=http://localhost:8081/verification
# Configure https://YOUR-API/v1/webhooks/veriff as the decision webhook in Veriff.
