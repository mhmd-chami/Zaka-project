# Web OAuth client from the same Google Cloud project as the Android/iOS clients.
EXPO_PUBLIC_API_URL=http://localhost:3001
# On a phone, use your computer's LAN IP instead of localhost.
EXPO_PUBLIC_SHOW_DEMO_ACCOUNTS=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-example.apps.googleusercontent.com

# Replace the fallback scheme in app.json before building for iOS.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.123456789-example
