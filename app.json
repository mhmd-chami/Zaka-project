{
  "expo": {
    "name": "SafeRoute",
    "slug": "saferoute",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "saferoute",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zaka.saferoute",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SafeRoute uses your location to guide you on a safe path and share live position with trusted contacts.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SafeRoute tracks your walk so friends can see you arrive safely."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.zaka.saferoute",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SafeRoute needs location to guide your walk and share live position."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
